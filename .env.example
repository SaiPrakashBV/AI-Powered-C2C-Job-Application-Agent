# Copy to .env (scripts/setup.ps1 does this and generates a random DB password). Never commit .env.
C2C_DB_USER=c2c
C2C_DB_PASSWORD=change-me
C2C_DB_PORT=5432
C2C_DB_URL=jdbc:postgresql://localhost:5432/c2c_agent
# "docker" = scripts start/stop the docker-compose PostgreSQL; "manual" = you run PostgreSQL yourself
C2C_DB_MODE=docker
C2C_PORT=8080
C2C_BIND_ADDRESS=127.0.0.1
# Personal data (resumes, attachments, logs, backups). Defaults to %USERPROFILE%\C2CAgent\data
# C2C_DATA_DIR=D:\C2CAgent\data
C2C_DEMO_MODE=false
# JVM heap for the backend
C2C_JAVA_OPTS=-Xmx768m
# Gmail: path to the Google Cloud OAuth "Desktop app" client JSON (see GMAIL_OAUTH_SETUP.md). Keep it out of git.
# C2C_GMAIL_CLIENT_FILE=C:\Users\you\C2CAgent\google-oauth-client.json
# or: C2C_GMAIL_CLIENT_ID=...  C2C_GMAIL_CLIENT_SECRET=...
